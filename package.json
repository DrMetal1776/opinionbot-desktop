{
  "name": "opinionbot-desktop",
  "version": "1.0.0",
  "description": "OpinionBot - An animated AI opinion robot for your desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.thoughtofview.opinionbot",
    "productName": "OpinionBot",
    "copyright": "Copyright 2025 ThoughtofView.com",
    "files": [
      "main.js",
      "index.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
